SUN2000_HOST=192.168.1.50
SUN2000_INTERVAL_SECONDS=60
SUN2000_UID=1000
SUN2000_GID=1000

# Use the NAS address and published PostgreSQL port, or a shared Docker
# network hostname and the database container's internal port.
TIMESCALE_DB_HOST=192.168.1.10
TIMESCALE_DB_PORT=5444
TIMESCALE_DB_NAME=pv_user_db
TIMESCALE_DB_USER=pv_user
PGPASSWORD=replace-with-your-database-password
